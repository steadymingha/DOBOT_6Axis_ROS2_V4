    <!-- ===== ONROBOT 2FG7 GRIPPER ===== -->

    <link name="gripper_base_link">
      <pose relative_to="gripper_2fg7_attach_joint">0 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <pose>-4.898915958379213e-05 2.84756960271082e-06 0.06811082379774974 0 0 0</pose>
        <mass>1.2646523179240972</mass>
        <inertia>
          <ixx>0.001504</ixx>
          <ixy>0.0</ixy>
          <ixz>-3e-06</ixz>
          <iyy>0.001812</iyy>
          <iyz>0.0</iyz>
          <izz>0.001053</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://agv_with_cr7/meshes/gripper/base_link.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="collision">

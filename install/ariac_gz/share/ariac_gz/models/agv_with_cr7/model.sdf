          <ixx>0.00291211377650885</ixx>
          <ixy>-7.47419584239082e-09</ixy>
          <ixz>1.94780650217368e-08</ixz>
          <iyy>0.00281918869862419</iyy>
          <iyz>0.000440963272842605</iyz>

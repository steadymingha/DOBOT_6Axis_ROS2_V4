      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://agv_with_cr7/meshes/cr7/base_link0.STL</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.792 0.820 0.933 1</diffuse>

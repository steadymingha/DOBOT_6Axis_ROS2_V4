    <joint name="gripper_2fg7_attach_joint" type="fixed">
      <pose relative_to="cr7_Link6">0 0 0 0 0 0</pose>
      <parent>cr7_Link6</parent>
      <child>gripper_base_link</child>
    </joint>

    <link name="gripper_left_attachment">
      <pose relative_to="gripper_gripper_joint">0 0 0 0 0 0</pose>
      <gravity>false</gravity>
    </link>

    <joint name="gripper_gripper_joint" type="prismatic">
      <pose relative_to="gripper_base_link">0 0 0.12005 0 0 0</pose>
      <parent>gripper_base_link</parent>
      <child>gripper_left_attachment</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <limit>
          <lower>0.0115</lower>
          <upper>0.10</upper>
          <effort>50</effort>
          <velocity>0.1</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>

    <link name="gripper_right_attachment">
      <pose relative_to="gripper_right_finger_joint">0 0 0 0 0 0</pose>
      <gravity>false</gravity>
    </link>

    <joint name="gripper_right_finger_joint" type="prismatic">
      <pose relative_to="gripper_base_link">0 0 0.12005 0 0 0</pose>
      <parent>gripper_base_link</parent>
      <child>gripper_right_attachment</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0.0115</lower>
          <upper>0.10</upper>
          <effort>50</effort>
          <velocity>0.1</velocity>
        </limit>
        <dynamics>
          <damping>5.0</damping>
          <friction>1.0</friction>
        </dynamics>
      </axis>
    </joint>


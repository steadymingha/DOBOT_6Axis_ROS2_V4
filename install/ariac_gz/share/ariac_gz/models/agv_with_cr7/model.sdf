    <!-- ===== AGV PLUGINS ===== -->

    <plugin
      filename="libAgvMotionPlugin.so"
      name="ariac_plugins::AgvMotionPlugin">
    </plugin>

    <plugin
      filename="libAgvTrayInterfacePlugin.so"
      name="ariac_plugins::AgvTrayInterfacePlugin">
    </plugin>

    <plugin
      filename="libEntityDisposalPlugin.so"
      name="ariac_plugins::EntityDisposalPlugin">
      <contact_link>base_link</contact_link>
    </plugin>

    <plugin
      filename="libTFPublisherPlugin.so"
      name="ariac_plugins::TFPublisherPlugin">
      <base_link>base_link</base_link>
      <static>false</static>
      <child link="tray_link" frame="tray_frame"/>
      <child link="slot_1_link" frame="slot1_frame" parent_frame="tray_frame" parent_link="tray_link"/>
      <child link="slot_2_link" frame="slot2_frame" parent_frame="tray_frame" parent_link="tray_link"/>
      <child link="slot_3_link" frame="slot3_frame" parent_frame="tray_frame" parent_link="tray_link"/>
      <child link="slot_4_link" frame="slot4_frame" parent_frame="tray_frame" parent_link="tray_link"/>
    </plugin>

  </model>

</sdf>

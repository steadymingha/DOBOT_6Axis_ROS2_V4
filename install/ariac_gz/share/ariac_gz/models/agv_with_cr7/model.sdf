<?xml version="1.0" ?>
<sdf version="1.11">
  <model name="agv_with_cr7">

    <!-- ===== AGV BASE STRUCTURE ===== -->

    <link name="base_link">
      <gravity>false</gravity>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://agv/meshes/agv.glb</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <density>2700</density>
        <pose>0 0 0.175 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.25 0.35</size>
          </box>
        </geometry>
      </collision>
      <sensor name="collision_detector" type="contact">
        <update_rate>30</update_rate>
        <contact>
          <collision>collision</collision>
        </contact>
      </sensor>
    </link>

    <link name="tray_link">
      <pose relative_to="base_link">0 0 0.35 0 0 -1.57</pose>
    </link>

    <link name="center_slot_link">
      <pose relative_to="tray_link">0.0 0.0 0.0095 0.0 0.0 0.0</pose>
    </link>

    <link name="slot_1_link">
      <pose relative_to="tray_link">-0.065 0.05 0.032 0 0 0</pose>
    </link>

    <link name="slot_2_link">
      <pose relative_to="tray_link">0.065 0.05 0.032 0 0 0</pose>
    </link>

    <link name="slot_3_link">
      <pose relative_to="tray_link">-0.065 -0.05 0.032 0 0 0</pose>
    </link>

    <link name="slot_4_link">
      <pose relative_to="tray_link">0.065 -0.05 0.032 0 0 0</pose>
    </link>

    <joint name="tray_joint" type="fixed">
      <parent>base_link</parent>
      <child>tray_link</child>
    </joint>

    <joint name="center_slot_joint" type="fixed">
      <parent>tray_link</parent>
      <child>center_slot_link</child>
    </joint>

    <joint name="slot_1_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_1_link</child>
    </joint>

    <joint name="slot_2_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_2_link</child>
    </joint>

    <joint name="slot_3_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_3_link</child>
    </joint>

    <joint name="slot_4_joint" type="fixed">
      <parent>tray_link</parent>
      <child>slot_4_link</child>
    </joint>

    <!-- ===== BASE CUBE (0.20 x 0.20 x 0.15 m) ===== -->

    <link name="cube_link">
      <pose relative_to="tray_link">0 0 0.075 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.02604</ixx>
          <iyy>0.02604</iyy>
          <izz>0.03333</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.20 0.20 0.15</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.20 0.20 0.15</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="cr7_cube_joint" type="fixed">
      <parent>tray_link</parent>
      <child>cube_link</child>
    </joint>

    <!-- ===== CR7 ROBOT ARM ===== -->

    <link name="cr7_base_link">
      <pose relative_to="cube_link">0 0 0.075 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <pose>-7.75881826404344e-06 0.00191109737802069 0.0289949710713939 0 0 0</pose>
        <mass>0.908795453638862</mass>
        <inertia>
          <ixx>0.00145446136430631</ixx>
          <ixy>4.10411509661615e-08</ixy>
          <ixz>-1.83603068187756e-07</ixz>
          <iyy>0.00134497445765809</iyy>
          <iyz>-6.24662501711042e-06</iyz>
          <izz>0.00215495523232905</izz>

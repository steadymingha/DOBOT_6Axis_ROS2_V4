<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Red box to be picked up at (0.4, 0.0) -->
    <model name="pick_box">
      <pose>0.4 0.0 0.025 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0000417</iyy><iyz>0</iyz>
            <izz>0.0000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>10.0</mu><mu2>10.0</mu2></ode>
            </friction>
            <contact>
              <ode><kp>1000000.0</kp><kd>1.0</kd></ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.05 0.05 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.15 0.15 1</ambient>
            <diffuse>0.9 0.15 0.15 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yellow flat marker showing the place target at (0.2, 0.35) -->
    <model name="place_marker">
      <pose>0.2 0.35 0.002 0 0 0</pose>
      <static>true</static>
      <link name="marker_link">
        <collision name="collision">
          <geometry>
            <box><size>0.08 0.08 0.004</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.08 0.08 0.004</size></box>
          </geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

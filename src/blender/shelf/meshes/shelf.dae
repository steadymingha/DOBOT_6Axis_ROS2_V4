  <library_effects>
    <effect id="wire_mesh-effect">
      <profile_COMMON>
        <newparam sid="wire_mesh_tex-surface">
          <surface type="2D">
            <init_from>wire_mesh_tex</init_from>
          </surface>
        </newparam>
        <newparam sid="wire_mesh_tex-sampler">
          <sampler2D>
            <source>wire_mesh_tex-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="wire_mesh_tex-sampler" texcoord="Cube_003-mesh-map-0"/>
            </diffuse>
            <reflectivity>
              <float sid="specular">1</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="post_metal-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">0.82 0.83 0.86 1</color>
            </diffuse>
            <reflectivity>
              <float sid="specular">1</float>
            </reflectivity>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="wire_mesh_tex" name="wire_mesh_tex">
      <init_from>wire_mesh_tex.png</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="wire_mesh-material" name="wire_mesh">
      <instance_effect url="#wire_mesh-effect"/>
    </material>
    <material id="post_metal-material" name="post_metal">
      <instance_effect url="#post_metal-effect"/>
    </material>
  </library_materials>

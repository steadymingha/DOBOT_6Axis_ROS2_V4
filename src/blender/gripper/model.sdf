<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- Fixed-jaw parallel gripper (flange Ø82 mm).
       Frame: tool axis = world Z (flange axis), grip centred on Z (x=y=0) so a
       held box hangs directly under the flange (minimal wrist moment).
       Flange mount face (top) is at z = +0.1401 m. Attach the wrist there.
       One actuated DOF: 'finger_joint' (prismatic +X) drives the pusher to clamp
       the workpiece against the fixed L-jaw. 0 = clamped on the 8.1 cm box. -->
  <model name='fixed_jaw_gripper'>

    <!-- ===== Fixed part: flange + body + integral L-jaw + fixed pad ===== -->
    <link name='base_link'>
      <inertial>
        <pose>0.01 0 0.09 0 0 0</pose>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.0009</ixx><iyy>0.0014</iyy><izz>0.0011</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='base_visual'>
        <geometry><mesh><uri>model://gripper/meshes/base.dae</uri></mesh></geometry>
      </visual>

      <collision name='flange_col'>
        <pose>0 0 0.1336 0 0 0</pose>
        <geometry><cylinder><radius>0.041</radius><length>0.013</length></cylinder></geometry>
      </collision>
      <collision name='body_col'>
        <pose>0 0 0.1210 0 0 0</pose>
        <geometry><box><size>0.1214 0.0912 0.0121</size></box></geometry>
      </collision>
      <collision name='plate_col'>
        <pose>0.0235 0 0.1100 0 0 0</pose>
        <geometry><box><size>0.1366 0.0912 0.010</size></box></geometry>
      </collision>
      <collision name='lip_col'>
        <pose>0.0469 0 0.0550 0 0 0</pose>
        <geometry><box><size>0.0127 0.0912 0.100</size></box></geometry>
      </collision>
      <collision name='pad_fixed_col'>
        <pose>0.0380 0 0.0550 0 0 0</pose>
        <geometry><box><size>0.005 0.090 0.100</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- ===== Moving part: pusher + body connector + moving pad ===== -->
    <link name='finger_link'>
      <inertial>
        <pose>-0.05 0 0.085 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00006</ixx><iyy>0.000025</iyy><izz>0.000045</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='finger_visual'>
        <geometry><mesh><uri>model://gripper/meshes/finger.dae</uri></mesh></geometry>
      </visual>

      <collision name='pusher_col'>
        <pose>-0.0515 0 0.0811 0 0 0</pose>
        <geometry><box><size>0.022 0.070 0.050</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <collision name='rod_col'>
        <pose>-0.0503 0 0.1166 0 0 0</pose>
        <geometry><box><size>0.0195 0.040 0.021</size></box></geometry>
      </collision>
      <collision name='pad_moving_col'>
        <pose>-0.0380 0 0.0810 0 0 0</pose>
        <geometry><box><size>0.005 0.060 0.038</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- ===== Actuated DOF =====
         +X = closing (pusher toward the L-jaw), -X = opening.
         0 = clamped on the 8.1 cm box; lower=-0.05 opens ~5 cm,
         upper=+0.07 closes fully on an empty grip. -->
    <joint name='finger_joint' type='prismatic'>
      <parent>base_link</parent>
      <child>finger_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.05</lower>
          <upper>0.07</upper>
          <effort>60</effort>
          <velocity>0.1</velocity>
        </limit>
        <dynamics><damping>5.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

  </model>
</sdf>

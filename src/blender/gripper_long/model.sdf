<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- Fixed-jaw parallel gripper (flange Ø82 mm).
       Frame: tool axis = world Z (flange axis). Flange mount face (top) at
       z = +0.1401 m  -> attach the robot wrist there.
       Grip line is at x ~= +0.053 m (jaws sit forward of the flange axis).
       One actuated DOF: 'finger_joint' (prismatic +X) drives the pusher to clamp
       the workpiece against the fixed L-jaw. 0 = clamped on the 8.1 cm box
       (gap ~83 mm); +X closes further, -X opens. -->
  <model name='fixed_jaw_gripper'>

    <!-- ===== Fixed part: flange + body + integral L-jaw + fixed pad ===== -->
    <link name='base_link'>
      <inertial>
        <pose>0.03 0 0.09 0 0 0</pose>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.0005</ixx><iyy>0.0012</iyy><izz>0.0012</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='base_visual'>
        <geometry><mesh><uri>model://gripper_long/meshes/base.dae</uri></mesh></geometry>
      </visual>

      <!-- Concave mesh collision (C-shape): the box pocket stays open. -->
      <collision name='base_col'>
        <geometry><mesh><uri>model://gripper_long/meshes/base.dae</uri></mesh></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- ===== Moving part: pusher (+ body connector) + moving pad ===== -->
    <link name='finger_link'>
      <inertial>
        <pose>0 0 0.085 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00008</ixx><iyy>0.000046</iyy><izz>0.000045</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='finger_visual'>
        <geometry><mesh><uri>model://gripper_long/meshes/finger.dae</uri></mesh></geometry>
      </visual>

      <collision name='finger_col'>
        <geometry><mesh><uri>model://gripper_long/meshes/finger.dae</uri></mesh></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- ===== Actuated DOF =====
         +X = closing (pusher toward the L-jaw), -X = opening.
         0 = clamped on the 8.1 cm box (gap ~83 mm); upper=+0.07 closes to ~13 mm
         gap (grip force / smaller parts), lower=-0.05 opens ~50 mm more. -->
    <joint name='finger_joint' type='prismatic'>
      <parent>base_link</parent>
      <child>finger_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.05</lower>
          <upper>0.07</upper>
          <effort>60</effort>
          <velocity>0.1</velocity>
        </limit>
        <dynamics><damping>5.0</damping><friction>1.0</friction></dynamics>
      </axis>
    </joint>

  </model>
</sdf>

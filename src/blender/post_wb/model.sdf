<?xml version='1.0'?>
<sdf version='1.7'>
  <!-- post_wb: stacked-box machine mock-up with two recessed displays.
       Overall extent: 1.02 (X) x 0.47 (Y) x 1.82 (Z) m.
       Mesh baked in world coords at export, so link pose is identity.
       Body is black stainless; the two +X-facing display recesses use a screen material. -->
  <model name='post_wb'>
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name='post_wb_link'>
      <pose>0 0 0 0 0 0</pose>
      <visual name='post_wb_visual'>
        <geometry>
          <mesh>
            <uri>model://post_wb/meshes/post_wb.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- per-part collision: one STL per object so the recesses stay open -->
      <collision name='Cube_big'>
        <geometry><mesh><uri>model://post_wb/collision/Cube_big.stl</uri></mesh></geometry>
      </collision>
      <collision name='Cube_001'>
        <geometry><mesh><uri>model://post_wb/collision/Cube_001.stl</uri></mesh></geometry>
      </collision>
      <collision name='Cube_pair'>
        <geometry><mesh><uri>model://post_wb/collision/Cube_pair.stl</uri></mesh></geometry>
      </collision>
    </link>
  </model>
</sdf>

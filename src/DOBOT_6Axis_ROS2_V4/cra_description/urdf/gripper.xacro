<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Single source of truth for the Blender fixed-jaw parallel gripper on Link6.
       Included by cr7_on_mpo700.urdf.xacro, cra_description/cr7_robot.xacro and
       cr7_moveit/config/cr7_robot.urdf.xacro so the collision boxes stay in sync
       (edit jaw geometry HERE only). Flange mount face at z=+0.1401; finger_joint
       axis -X: positive = opening, negative = closing.
       gazebo_props: emit the soft-contact + gravity-off Gazebo tags (true for the
       Gazebo-sim robots; false for the MoveIt-only description, which has none). -->
  <xacro:macro name="cr7_gripper" params="gazebo_props:=true">

    <link name="gripper_base_link">
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.0060" ixy="0" ixz="0" iyy="0.0079" iyz="0" izz="0.0049"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:///home/user/dobot_ws/src/blender/gripper_long/meshes/base.dae"/>
        </geometry>
      </visual>
      <!-- Fitted to gripper_long/meshes/base.dae per-part bounds (jaw_fixed, pad_fixed, body, flange) -->
      <collision>  <!-- fixed-jaw top beam (jaw_fixed top): X[-0.021,0.181] Y[+-0.046] Z[0.105,0.115] -->
        <origin xyz="0.0801 0 0.110" rpy="0 0 0"/>
        <geometry><box size="0.2016 0.0912 0.010"/></geometry>
      </collision>
      <collision>  <!-- fixed-jaw column + contact pad: X[0.163,0.181] Y[+-0.046] Z[0.055,0.105], inner face = pad at X=0.1632 -->
        <origin xyz="0.17205 0 0.080" rpy="0 0 0"/>
        <geometry><box size="0.0177 0.0912 0.050"/></geometry>
      </collision>
      <collision>  <!-- top plate (body): X[-0.061,0.071] Y[+-0.046] Z[0.115,0.127] -->
        <origin xyz="0.00505 0 0.12105" rpy="0 0 0"/>
        <geometry><box size="0.1315 0.0912 0.0121"/></geometry>
      </collision>
      <collision>  <!-- mount boss (flange): r0.041 at Z[0.127,0.140] (flange face) -->
        <origin xyz="0 0 0.13355" rpy="0 0 0"/>
        <geometry><cylinder radius="0.041" length="0.013"/></geometry>
      </collision>
    </link>

    <joint name="gripper_attach_joint" type="fixed">
      <origin xyz="0 0 0.1401" rpy="3.14159265359 0 0"/>
      <parent link="Link6"/>
      <child link="gripper_base_link"/>
    </joint>

    <link name="gripper_finger_link">
      <inertial>
        <origin xyz="-0.073 0 0.023" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00035"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file:///home/user/dobot_ws/src/blender/gripper_long/meshes/finger.dae"/>
        </geometry>
      </visual>
      <collision>  <!-- moving jaw + contact pad (jaw_moving+pad_moving): X[0.055,0.082] Y[+-0.035] Z[0.056,0.127], outer face = pad at X=0.0822 -->
        <origin xyz="0.0687 0 0.0916" rpy="0 0 0"/>
        <geometry><box size="0.027 0.070 0.071"/></geometry>
      </collision>
    </link>

    <joint name="gripper_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_finger_link"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-0.07" upper="0.10" effort="60" velocity="0.1"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <xacro:if value="${gazebo_props}">
      <!-- Soft contact so the squeeze doesn't fire a huge impulse and eject the box -->
      <gazebo reference="gripper_base_link">
        <material>Gazebo/DarkGrey</material>
        <gravity>false</gravity>
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <selfCollide>true</selfCollide>
      </gazebo>
      <gazebo reference="gripper_finger_link">
        <material>Gazebo/Orange</material>
        <gravity>false</gravity>
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <selfCollide>true</selfCollide>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>

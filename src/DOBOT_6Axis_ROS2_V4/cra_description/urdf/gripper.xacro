<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Single source of truth for the Blender fixed-jaw parallel gripper on Link6.
       Included by cr7_on_mpo700.urdf.xacro, cra_description/cr7_robot.xacro and
       cr7_moveit/config/cr7_robot.urdf.xacro so the geometry stays in sync
       (edit HERE only). Flange mount face at z=+0.1401; finger_joint axis -X:
       positive = opening, negative = closing.
       Geometry mirrors gripper_long/model.sdf: per-part .dae visual meshes and
       per-part convex .stl collision meshes (mesh path base set below).
       gazebo_props: emit the soft-contact + gravity-off Gazebo tags (true for the
       Gazebo-sim robots; false for the MoveIt-only description, which has none). -->
  <xacro:macro name="cr7_gripper" params="gazebo_props:=true">

    <xacro:property name="mesh" value="file:///home/user/dobot_ws/src/blender/gripper_long"/>

    <!-- Fixed part: flange + body + integral L-jaw + fixed pad -->
    <link name="gripper_base_link">
      <inertial>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <mass value="0.8"/>
        <inertia ixx="0.0060" ixy="0" ixz="0" iyy="0.0079" iyz="0" izz="0.0049"/>
      </inertial>
      <visual><geometry><mesh filename="${mesh}/meshes/flange.dae"/></geometry></visual>
      <visual><geometry><mesh filename="${mesh}/meshes/body.dae"/></geometry></visual>
      <visual><geometry><mesh filename="${mesh}/meshes/jaw_fixed.dae"/></geometry></visual>
      <visual><geometry><mesh filename="${mesh}/meshes/pad_fixed.dae"/></geometry></visual>
      <collision><geometry><mesh filename="${mesh}/collision/flange.stl"/></geometry></collision>
      <collision><geometry><mesh filename="${mesh}/collision/body.stl"/></geometry></collision>
      <collision><geometry><mesh filename="${mesh}/collision/jaw_fixed.stl"/></geometry></collision>
      <collision><geometry><mesh filename="${mesh}/collision/pad_fixed.stl"/></geometry></collision>
    </link>

    <joint name="gripper_attach_joint" type="fixed">
      <origin xyz="0 0 0.1401" rpy="3.14159265359 0 0"/>
      <parent link="Link6"/>
      <child link="gripper_base_link"/>
    </joint>

    <!-- Moving part: pusher (+ body connector) + moving pad -->
    <link name="gripper_finger_link">
      <inertial>
        <origin xyz="-0.073 0 0.023" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00035"/>
      </inertial>
      <visual><geometry><mesh filename="${mesh}/meshes/jaw_moving.dae"/></geometry></visual>
      <visual><geometry><mesh filename="${mesh}/meshes/pad_moving.dae"/></geometry></visual>
      <collision><geometry><mesh filename="${mesh}/collision/jaw_moving.stl"/></geometry></collision>
      <collision><geometry><mesh filename="${mesh}/collision/pad_moving.stl"/></geometry></collision>
    </link>

    <joint name="gripper_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_finger_link"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-0.07" upper="0.10" effort="60" velocity="0.1"/>
      <dynamics damping="5.0" friction="1.0"/>
    </joint>

    <xacro:if value="${gazebo_props}">
      <!-- Soft contact so the squeeze doesn't fire a huge impulse and eject the box -->
      <gazebo reference="gripper_base_link">
        <material>Gazebo/DarkGrey</material>
        <gravity>false</gravity>
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <selfCollide>true</selfCollide>
      </gazebo>
      <gazebo reference="gripper_finger_link">
        <material>Gazebo/Orange</material>
        <gravity>false</gravity>
        <mu1>1.2</mu1>
        <mu2>1.2</mu2>
        <kp>1000000.0</kp>
        <kd>1.0</kd>
        <minDepth>0.001</minDepth>
        <maxVel>0.1</maxVel>
        <selfCollide>true</selfCollide>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>

<?xml version="1.0"?>
<!-- CR7 arm mounted on a cube platform on top of the Neobotix MPO-700 AGV.
     Single URDF so the arm rigidly follows the AGV as it drives.
     - AGV motion:  cmd_vel -> libgazebo_ros_planar_move.so (MPO-700 ObjectController)
     - CR7 control: cr7_group_controller / gripper_controller via gazebo_ros2_control
     The CR7 root link is kept named "base_link" so cbirrt_pick_place.py
     (frame_id="base_link") and the MoveIt config keep working unchanged. -->
<robot name="cr7_on_mpo700" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Args required by the imported MPO-700 description -->
  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="use_docking_adapter" default="false"/>

  <!-- OmniDriveModule joint type (fixed for simulation) -->
  <xacro:property name="ODM_joint_type" value="fixed"/>

  <!-- ===================== MPO-700 AGV base ===================== -->
  <!-- Body defines mpo_base_link (renamed from base_link to avoid clashing
       with the CR7 base_link), wheels, casters and lidars. -->
  <xacro:include filename="$(find cra_description)/urdf/cr7_mpo700_body.urdf.xacro"/>

  <xacro:if value="$(arg use_gazebo)">
    <!-- Gazebo: planar move plugin (cmd_vel), wheel friction, lidar sensors -->
    <xacro:include filename="$(find cra_description)/urdf/cr7_mpo700_gazebo.urdf.xacro"/>
  </xacro:if>

  <!-- ===================== Cube mounting platform ===================== -->
  <!-- Cube sits on top of the AGV body; CR7 base bolts onto the cube top.
       Heights are initial estimates (mpo_base_link frame) to be fine-tuned
       visually in Gazebo after the first run. -->
  <link name="cube_link">
    <!-- Base anchor (cube_link). The real instability is NOT weight: gravity is
         already off on the base and all arm links, so there is no restoring force.
         When a position-controlled arm joint accelerates a link, Newton's 3rd law
         feeds an equal-and-opposite REACTION torque back into the base. The
         planar-move plugin only fixes x/y/yaw kinematically, leaving roll/pitch/z
         to physics, so a small base roll/pitch inertia lets that reaction torque
         tip the AGV (alpha = tau / I). Fix: give the base a HUGE rotational
         inertia so the same reaction torque produces negligible angular
         acceleration -> the base stays level while the arm moves. The low CoM and
         large mass keep it planted as ballast. NONE of this affects the pinocchio
         IK/collision solver (cube_link is a fixed, locked link, so its inertia
         never enters the purely kinematic IK or collision checks); it only
         changes Gazebo physics. -->
    <inertial>
      <mass value="500.0"/>
      <origin xyz="0 0 -0.35" rpy="0 0 0"/>
      <inertia ixx="2000.0" ixy="0" ixz="0" iyy="2000.0" iyz="0" izz="2000.0"/>
    </inertial>
    <!-- Front half (+X): robot mounting area, 0.3705 x 0.509 x 0.66 m
         (grown upward to put base_link 1000 mm above the floor; bottom still
         rests on the AGV top) -->
    <visual>
      <origin xyz="0.18525 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.66"/>
      </geometry>
      <material name="cube_gray">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.18525 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.66"/>
      </geometry>
    </collision>
    <!-- Rear half (-X): magazine pocket, 0.3705 x 0.509 x 0.61 m, top recessed
         5 cm below the front half (raised in lockstep with it) -->
    <visual>
      <origin xyz="-0.18525 0 0.135" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.61"/>
      </geometry>
      <material name="cube_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.18525 0 0.135" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.61"/>
      </geometry>
    </collision>
    <!-- Magazine pocket markers: 4 visual-only rectangles (0.236 x 0.081 m,
         the box bottom face) on the rear-half top surface (cube z=0.440),
         arrayed along Y with 11.8 cm pitch (8.1 cm pocket + 3.7 cm gap),
         centered on the rear half (cube x=-0.18525). No collision, so
         planning/physics are unaffected. These mark place target 2, which is
         constant in base_link: x=0.3705, y in {+-0.177,+-0.059}, z=-0.05. -->
    <visual>
      <origin xyz="-0.18525 0.177 0.4415" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"><color rgba="0.1 0.9 0.2 0.6"/></material>
    </visual>
    <visual>
      <origin xyz="-0.18525 0.059 0.4415" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"/>
    </visual>
    <visual>
      <origin xyz="-0.18525 -0.059 0.4415" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"/>
    </visual>
    <visual>
      <origin xyz="-0.18525 -0.177 0.4415" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"/>
    </visual>
  </link>

  <!-- AGV body top -> cube_link frame origin.
       MPO-700 body mesh top = mpo_base_link + 0.35 m (box bottoms rest here).
       cube_link origin kept at mpo z = 0.520; box bottoms sit at cube z = -0.17
       (mpo 0.35). Front section is 0.66 m tall => top at cube z = 0.49.
       CR7 base_link lands at mpo z = 0.520 + 0.49 = 1.010; floor sits at mpo z = +0.01,
       so floor -> base_link = 1.000 m (target). -->
  <joint name="cube_joint" type="fixed">
    <origin xyz="0 0 0.520" rpy="0 0 0"/>
    <parent link="mpo_base_link"/>
    <child link="cube_link"/>
  </joint>

  <!-- Cube top -> CR7 base_link; arm on front half (+X), current posture preserved.
       z = front-section top in cube frame = 0.49. -->
  <joint name="arm_mount_joint" type="fixed">
    <origin xyz="0.18525 0 0.49" rpy="0 0 3.14159"/>
    <parent link="cube_link"/>
    <child link="base_link"/>
  </joint>

  <!-- ===================== CR7 arm ===================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="-7.75881826404344E-06 0.00191109737802069 0.0289949710713939" rpy="0 0 0" />
      <mass value="0.908795453638862" />
      <inertia ixx="0.00145446136430631" ixy="4.10411509661615E-08" ixz="-1.83603068187756E-07"
               iyy="0.00134497445765809" iyz="-6.24662501711042E-06" izz="0.00215495523232905" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/base_link0.STL" />
      </geometry>
      <material name="cr7_silver">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/base_link0.STL" />
      </geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin xyz="2.42083892138974E-07 -0.00325669708857515 -0.00767435596457115" rpy="0 0 0" />
      <mass value="1.6123155679073" />
      <inertia ixx="0.00291211377650885" ixy="-7.47419584239082E-09" ixz="1.94780650217368E-08"
               iyy="0.00281918869862419" iyz="0.000440963272842605" izz="0.00328358201221721" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J1.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.147" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link1" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link2">
    <inertial>
      <origin xyz="-0.188500103625708 -7.46110088887752E-07 0.142319304936727" rpy="0 0 0" />
      <mass value="5.28764336862191" />
      <inertia ixx="0.00860086052884714" ixy="3.30521626209469E-09" ixz="-4.99788929762243E-09"
               iyy="0.0181761454963347" iyz="-1.56481985512198E-08" izz="0.0189188799857172" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J2.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.57080420997483 1.57079631189374 -3.14158502419526" />
    <parent link="Link1" />
    <child link="Link2" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link3">
    <inertial>
      <origin xyz="-0.129084033261017 0.000409825982416691 -0.0024891265183234" rpy="0 0 0" />
      <mass value="2.64536322797469" />
      <inertia ixx="0.00313429310657436" ixy="8.58567214179718E-06" ixz="0.0001236219933347"
               iyy="0.00583755221707048" iyz="-3.84538201491329E-07" izz="0.00609610718076456" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J3.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J3.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="-0.377 0 0.025" rpy="0 0 0" />
    <parent link="Link2" />
    <child link="Link3" />
    <axis xyz="0 0 1" />
    <limit lower="-2.79" upper="2.79" effort="300" velocity="100" />
  </joint>

  <link name="Link4">
    <inertial>
      <origin xyz="-0.00098049161725656 -0.00207570116557487 -0.00155508673006152" rpy="0 0 0" />
      <mass value="0.670573134819647" />
      <inertia ixx="0.000669371731621344" ixy="-5.32805461934157E-08" ixz="3.52586632357936E-07"
               iyy="0.000654228488306913" iyz="0.000110801103983602" izz="0.000653654751027863" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J4.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J4.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-0.306999999999969 0 0.116" rpy="0 0 -1.57079677671549" />
    <parent link="Link3" />
    <child link="Link4" />
    <axis xyz="0 0 0.999999999969965" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link5">
    <inertial>
      <origin xyz="-0.00139233872001005 -0.00449255371185306 -0.00130478579616922" rpy="0 0 0" />
      <mass value="0.725828190120638" />
      <inertia ixx="0.00073002940905788" ixy="1.46530702319641E-07" ixz="-1.21461719923983E-07"
               iyy="0.000710023403641111" iyz="-0.000119103387993809" izz="0.000712169450212708" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J5.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J5.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 -0.116 0" rpy="1.5707963267949 0 0" />
    <parent link="Link4" />
    <child link="Link5" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link6">
    <inertial>
      <origin xyz="-0.00134099075400824 9.61028193323665E-05 -0.0192856508049091" rpy="0 0 0" />
      <mass value="0.157885328078873" />
      <inertia ixx="7.80450650011017E-05" ixy="3.56327806101489E-09" ixz="-3.98217377472077E-11"
               iyy="7.91678595101433E-05" iyz="-1.3821786505554E-07" izz="0.000129505866960959" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J6.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J6.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 0.104999656773681 0" rpy="-1.5707963267949 0 0" />
    <parent link="Link5" />
    <child link="Link6" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- Base + cube: no gravity. The AGV is velocity-controlled by the planar-move
       plugin and the arm is position-controlled. NOTE (2026-07-12): roll/pitch/z
       still RATCHET from contact impulses regardless of gravity, because
       gazebo_ros_planar_move zeroes angular-x/y and linear-z velocity every tick
       (no restoring path; gravity-on was tried and changed nothing). The shelf
       sequence therefore re-LEVELS the base by teleport at each park
       (shelf_pick_place._level_base), a sim-only workaround; the real AGV's
       mass/suspension makes this failure class physically impossible. -->
  <gazebo reference="mpo_base_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="cube_link">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- CR7 links: no gravity (arm is position-controlled), self collision on -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link1">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link2">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link3">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link4">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link5">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link6">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Gripper: single source of truth in gripper.xacro (Gazebo sim -> gazebo_props on) -->
  <xacro:include filename="$(find cra_description)/urdf/gripper.xacro"/>
  <xacro:cr7_gripper/>

  <!-- ===================== Eye-in-hand RealSense D405 ===================== -->
  <!-- Self-contained D405 (no realsense2_description macro): d405.stl is the
       visual AND collision mesh so the camera body shows in Gazebo. Absolute
       file:// path (NOT $(find ...)) so the planner's xacro processing under
       `uv run` works without realsense2_description on AMENT_PREFIX_PATH.
       Mounted on the FRONT edge of the top plate (gripper_base_link frame:
       top plate X[-0.061,0.071] Z[0.115,0.127]), looking FORWARD along the
       gripper reach axis (link +X) toward the jaws/grasp, body upright (+Z up).
       Lens = link +X, so joint rpy=0 aims it straight forward. Mesh rpy
       "pi/2 0 pi/2" faces the lens along +X (leave it).
       === TUNING KNOBS (d405_joint origin) ===
         xyz  = position. X = reach axis (lower X = set back over the plate for a
                wider view; plate spans X[-0.061,0.071]), Y = sideways,
                Z = height (0.165 lifts the 42mm body clear of the gripper top
                ~0.140; body spans ~0.144..0.186).
         rpy  = aim. "0 0 0" = straight forward; 2nd (pitch) tilts down(+)/up(-);
                1st (roll) spins the image. -->
  <link name="d405_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 1.5707963"/>
      <geometry>
        <mesh filename="file:///home/user/dobot_ws/src/realsense-ros/realsense2_description/meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="d405_alu"><color rgba="0.7 0.72 0.75 1"/></material>
    </visual>
    <!-- Camera collision DISABLED on purpose: the D405 body at the wrist kept
         blocking tight slot approaches (planner) and snagging the device (Gazebo).
         The camera is a sensor, not a structural part; the wrist/gripper collision
         geometry still guards this region. Restore the block below if a real-robot
         deployment needs the camera body protected.
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 1.5707963"/>
      <geometry>
        <mesh filename="file:///home/user/dobot_ws/src/realsense-ros/realsense2_description/meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    -->
  </link>
  <joint name="d405_joint" type="fixed">
    <origin xyz="0.071 0 0.147" rpy="0 0 0"/>
    <parent link="gripper_base_link"/>
    <child link="d405_link"/>
  </joint>

  <!-- Optical frame: ROS image convention (z forward, x right, y down). -->
  <link name="d405_optical_frame"/>
  <joint name="d405_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="d405_link"/>
    <child link="d405_optical_frame"/>
  </joint>

  <gazebo reference="d405_link">
    <material>Gazebo/Grey</material>
    <!-- type="depth": one sensor emits BOTH the color image and an aligned depth
         image (same optical frame, so depth registers to color for free). The
         depth-hybrid vision (device_pose_in_base) fixes the tag RANGE from this;
         color stays for AprilTag detection. Topic names are remapped to match the
         REAL realsense2_camera (camera_name:=d405) exactly, so the vision node
         subscribes the same names in sim and on the real robot
         (docs/real_robot_transition.md). -->
    <sensor type="depth" name="d405_depth">
      <!-- ponytail: 848x480@15 + visualize off keeps Gazebo bring-up fast.
           A camera sensor blocks world load until Ogre renders its first frames;
           1280x720@30 stalled it. 848x480 is a native D405 mode (same 87 deg FOV)
           and is plenty to frame the grasp. Bump back up only if you need detail. -->
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <!-- Real D405: 87 deg H FOV, 848x480 (16:9 -> ~56 deg V, datasheet 58),
           ideal Min-Z ~0.07 m. far kept large so the whole scene still renders.
           Distortion/depth-noise are NOT modelled (Gazebo Classic pinhole only);
           real depth has holes/noise the sim won't show (see docs/real_robot_transition.md). -->
      <camera name="d405">
        <horizontal_fov>1.5184</horizontal_fov> <!-- 87 deg -->
        <image><width>848</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.07</near><far>5.0</far></clip>
      </camera>
      <plugin name="d405_camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/camera/d405</namespace>
          <!-- Depth under the realsense2_camera name (aligned_depth_to_color);
               color/camera_info already match once the namespace is /camera/d405. -->
          <remapping>color/depth/image_raw:=aligned_depth_to_color/image_raw</remapping>
          <remapping>color/depth/camera_info:=aligned_depth_to_color/camera_info</remapping>
        </ros>
        <camera_name>color</camera_name>
        <frame_name>d405_optical_frame</frame_name>
        <!-- Depth clamp: matches the D405 usable near/far so out-of-range pixels
             drop out instead of reporting bogus depth. -->
        <min_depth>0.07</min_depth>
        <max_depth>5.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== CR7 ros2_control ===================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <!-- Spawn AT the hub (tool-down standby, TCP=(0.33,0,0.32)): the same pose
         wirebonder_pick_place.py drives to with go_to_hub() at startup. Spawning
         here means the arm never has to swing from a folded/upright pose into the
         hub on bring-up. Joints (rad) from _calc_hub_q.py (project IK, collision-
         gated): J1..J6 deg = -26.0,+19.7,-107.9,0,-87.4,-24.7. -->
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.45320</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">

<?xml version="1.0"?>
<!-- CR7 arm mounted on a cube platform on top of the Neobotix MPO-700 AGV.
     Single URDF so the arm rigidly follows the AGV as it drives.
     - AGV motion:  cmd_vel -> libgazebo_ros_planar_move.so (MPO-700 ObjectController)
     - CR7 control: cr7_group_controller / gripper_controller via gazebo_ros2_control
     The CR7 root link is kept named "base_link" so cbirrt_pick_place.py
     (frame_id="base_link") and the MoveIt config keep working unchanged. -->
<robot name="cr7_on_mpo700" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Args required by the imported MPO-700 description -->
  <xacro:arg name="use_gazebo" default="true"/>
  <xacro:arg name="use_docking_adapter" default="false"/>

  <!-- OmniDriveModule joint type (fixed for simulation) -->
  <xacro:property name="ODM_joint_type" value="fixed"/>

  <!-- ===================== MPO-700 AGV base ===================== -->
  <!-- Body defines mpo_base_link (renamed from base_link to avoid clashing
       with the CR7 base_link), wheels, casters and lidars. -->
  <xacro:include filename="$(find cra_description)/urdf/cr7_mpo700_body.urdf.xacro"/>

  <xacro:if value="$(arg use_gazebo)">
    <!-- Gazebo: planar move plugin (cmd_vel), wheel friction, lidar sensors -->
    <xacro:include filename="$(find cra_description)/urdf/cr7_mpo700_gazebo.urdf.xacro"/>
  </xacro:if>

  <!-- ===================== Cube mounting platform ===================== -->
  <!-- Cube sits on top of the AGV body; CR7 base bolts onto the cube top.
       Heights are initial estimates (mpo_base_link frame) to be fine-tuned
       visually in Gazebo after the first run. -->
  <link name="cube_link">
    <!-- Base anchor (cube_link). The real instability is NOT weight: gravity is
         already off on the base and all arm links, so there is no restoring force.
         When a position-controlled arm joint accelerates a link, Newton's 3rd law
         feeds an equal-and-opposite REACTION torque back into the base. The
         planar-move plugin only fixes x/y/yaw kinematically, leaving roll/pitch/z
         to physics, so a small base roll/pitch inertia lets that reaction torque
         tip the AGV (alpha = tau / I). Fix: give the base a HUGE rotational
         inertia so the same reaction torque produces negligible angular
         acceleration -> the base stays level while the arm moves. The low CoM and
         large mass keep it planted as ballast. NONE of this affects the pinocchio
         IK/collision solver (cube_link is a fixed, locked link, so its inertia
         never enters the purely kinematic IK or collision checks); it only
         changes Gazebo physics. -->
    <inertial>
      <mass value="500.0"/>
      <origin xyz="0 0 -0.35" rpy="0 0 0"/>
      <inertia ixx="2000.0" ixy="0" ixz="0" iyy="2000.0" iyz="0" izz="2000.0"/>
    </inertial>
    <!-- Front half (+X): robot mounting area, 0.3705 x 0.509 x 0.34 m
         (raised to put base_link 680 mm above the floor) -->
    <visual>
      <origin xyz="0.18525 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.34"/>
      </geometry>
      <material name="cube_gray">
        <color rgba="0.25 0.25 0.25 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.18525 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.34"/>
      </geometry>
    </collision>
    <!-- Rear half (-X): magazine pocket, 0.3705 x 0.509 x 0.29 m, recessed 5 cm from top -->
    <visual>
      <origin xyz="-0.18525 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.29"/>
      </geometry>
      <material name="cube_gray"/>
    </visual>
    <collision>
      <origin xyz="-0.18525 0 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.3705 0.509 0.29"/>
      </geometry>
    </collision>
    <!-- Magazine pocket markers: 4 visual-only rectangles (0.236 x 0.081 m,
         the box bottom face) on the rear-half top surface (cube z=0.120),
         arrayed along Y with 11.8 cm pitch (8.1 cm pocket + 3.7 cm gap),
         centered on the rear half (cube x=-0.18525). No collision, so
         planning/physics are unaffected. These mark place target 2, which is
         constant in base_link: x=0.3705, y in {+-0.177,+-0.059}, z=-0.05. -->
    <visual>
      <origin xyz="-0.18525 0.177 0.1215" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"><color rgba="0.1 0.9 0.2 0.6"/></material>
    </visual>
    <visual>
      <origin xyz="-0.18525 0.059 0.1215" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"/>
    </visual>
    <visual>
      <origin xyz="-0.18525 -0.059 0.1215" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"/>
    </visual>
    <visual>
      <origin xyz="-0.18525 -0.177 0.1215" rpy="0 0 0"/>
      <geometry><box size="0.236 0.081 0.003"/></geometry>
      <material name="pocket_marker"/>
    </visual>
  </link>

  <!-- AGV body top -> cube center.
       MPO-700 body mesh top = mpo_base_link + 0.35 m (cube bottom rests here).
       Robot section height 0.34 m (half 0.17) => cube center z = 0.35 + 0.17 = 0.520.
       CR7 base_link lands at mpo z = 0.520 + 0.17 = 0.690; floor sits at mpo z = +0.01,
       so floor -> base_link = 0.680 m (target). -->
  <joint name="cube_joint" type="fixed">
    <origin xyz="0 0 0.520" rpy="0 0 0"/>
    <parent link="mpo_base_link"/>
    <child link="cube_link"/>
  </joint>

  <!-- Cube top -> CR7 base_link; arm on front half (+X), current posture preserved.
       z = robot-section half height = 0.17 (cube top surface). -->
  <joint name="arm_mount_joint" type="fixed">
    <origin xyz="0.18525 0 0.17" rpy="0 0 3.14159"/>
    <parent link="cube_link"/>
    <child link="base_link"/>
  </joint>

  <!-- ===================== CR7 arm ===================== -->

  <link name="base_link">
    <inertial>
      <origin xyz="-7.75881826404344E-06 0.00191109737802069 0.0289949710713939" rpy="0 0 0" />
      <mass value="0.908795453638862" />
      <inertia ixx="0.00145446136430631" ixy="4.10411509661615E-08" ixz="-1.83603068187756E-07"
               iyy="0.00134497445765809" iyz="-6.24662501711042E-06" izz="0.00215495523232905" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/base_link0.STL" />
      </geometry>
      <material name="cr7_silver">
        <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/base_link0.STL" />
      </geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin xyz="2.42083892138974E-07 -0.00325669708857515 -0.00767435596457115" rpy="0 0 0" />
      <mass value="1.6123155679073" />
      <inertia ixx="0.00291211377650885" ixy="-7.47419584239082E-09" ixz="1.94780650217368E-08"
               iyy="0.00281918869862419" iyz="0.000440963272842605" izz="0.00328358201221721" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J1.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.147" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link1" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link2">
    <inertial>
      <origin xyz="-0.188500103625708 -7.46110088887752E-07 0.142319304936727" rpy="0 0 0" />
      <mass value="5.28764336862191" />
      <inertia ixx="0.00860086052884714" ixy="3.30521626209469E-09" ixz="-4.99788929762243E-09"
               iyy="0.0181761454963347" iyz="-1.56481985512198E-08" izz="0.0189188799857172" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J2.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J2.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint2" type="revolute">
    <origin xyz="0 0 0" rpy="-1.57080420997483 1.57079631189374 -3.14158502419526" />
    <parent link="Link1" />
    <child link="Link2" />
    <axis xyz="0 0 1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link3">
    <inertial>
      <origin xyz="-0.129084033261017 0.000409825982416691 -0.0024891265183234" rpy="0 0 0" />
      <mass value="2.64536322797469" />
      <inertia ixx="0.00313429310657436" ixy="8.58567214179718E-06" ixz="0.0001236219933347"
               iyy="0.00583755221707048" iyz="-3.84538201491329E-07" izz="0.00609610718076456" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J3.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J3.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint3" type="revolute">
    <origin xyz="-0.377 0 0.025" rpy="0 0 0" />
    <parent link="Link2" />
    <child link="Link3" />
    <axis xyz="0 0 1" />
    <limit lower="-2.79" upper="2.79" effort="300" velocity="100" />
  </joint>

  <link name="Link4">
    <inertial>
      <origin xyz="-0.00098049161725656 -0.00207570116557487 -0.00155508673006152" rpy="0 0 0" />
      <mass value="0.670573134819647" />
      <inertia ixx="0.000669371731621344" ixy="-5.32805461934157E-08" ixz="3.52586632357936E-07"
               iyy="0.000654228488306913" iyz="0.000110801103983602" izz="0.000653654751027863" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J4.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J4.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint4" type="revolute">
    <origin xyz="-0.306999999999969 0 0.116" rpy="0 0 -1.57079677671549" />
    <parent link="Link3" />
    <child link="Link4" />
    <axis xyz="0 0 0.999999999969965" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link5">
    <inertial>
      <origin xyz="-0.00139233872001005 -0.00449255371185306 -0.00130478579616922" rpy="0 0 0" />
      <mass value="0.725828190120638" />
      <inertia ixx="0.00073002940905788" ixy="1.46530702319641E-07" ixz="-1.21461719923983E-07"
               iyy="0.000710023403641111" iyz="-0.000119103387993809" izz="0.000712169450212708" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J5.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J5.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint5" type="revolute">
    <origin xyz="0 -0.116 0" rpy="1.5707963267949 0 0" />
    <parent link="Link4" />
    <child link="Link5" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <link name="Link6">
    <inertial>
      <origin xyz="-0.00134099075400824 9.61028193323665E-05 -0.0192856508049091" rpy="0 0 0" />
      <mass value="0.157885328078873" />
      <inertia ixx="7.80450650011017E-05" ixy="3.56327806101489E-09" ixz="-3.98217377472077E-11"
               iyy="7.91678595101433E-05" iyz="-1.3821786505554E-07" izz="0.000129505866960959" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J6.STL" />
      </geometry>
      <material name="cr7_silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file://$(find cra_description)/meshes/cr7/J6.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="joint6" type="revolute">
    <origin xyz="0 0.104999656773681 0" rpy="-1.5707963267949 0 0" />
    <parent link="Link5" />
    <child link="Link6" />
    <axis xyz="0 0 -1" />
    <limit lower="-6.27" upper="6.27" effort="300" velocity="100" />
  </joint>

  <!-- Base + cube: no gravity. The AGV is velocity-controlled by the planar-move
       plugin (it does not rely on weight/wheel friction) and the arm is
       position-controlled, so gravity on these heavy bodies only adds tipping /
       contact-instability with nothing holding roll-pitch. Turning it off makes
       the robot unable to tip while driving or folding the arm. -->
  <gazebo reference="mpo_base_link">
    <gravity>false</gravity>
  </gazebo>
  <gazebo reference="cube_link">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>

  <!-- CR7 links: no gravity (arm is position-controlled), self collision on -->
  <gazebo reference="base_link">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link1">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link2">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link3">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link4">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link5">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="Link6">
    <gravity>false</gravity>
    <selfCollide>true</selfCollide>
  </gazebo>

  <!-- Blender fixed-jaw parallel gripper attached to Link6.
       Flange mount face at z=+0.1401 in gripper frame (measured from mesh).
       finger_joint axis -X: positive = opening, negative = closing. -->
  <link name="gripper_base_link">
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0060" ixy="0" ixz="0" iyy="0.0079" iyz="0" izz="0.0049"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/user/dobot_ws/src/blender/gripper/meshes/base.dae"/>
      </geometry>
    </visual>
    <!-- Collision refit to hug base.dae visual parts (link frame, node tf applied).
         Old primitives were phantom jaws reaching down to z=-0.116 where the visual
         has nothing, pushing the shelf box without visual contact. The small side
         tab (Cube_099) lies fully inside the body block, so it is omitted. -->
    <!-- Fixed jaw (jaw_fixed + pad_fixed meshes) is C-shaped: a top beam plus
         an outer column carrying the pad on its inner face. Two boxes that hug
         those parts, leaving the grasp gap between the pads OPEN. The previous
         single box was the whole jaw AABB: it filled the grasp gap with solid
         collision, so the box was ejected on descend without visual contact. -->
    <collision>  <!-- fixed-jaw top beam: X[0.009,0.107] Y[+-0.046] Z[0.105,0.115] -->
      <origin xyz="0.0581 0 0.110" rpy="0 0 0"/>
      <geometry><box size="0.098 0.0912 0.010"/></geometry>
    </collision>
    <collision>  <!-- fixed-jaw column + pad: X[0.0894,0.1071] Y[+-0.046] Z[0.055,0.105] -->
      <origin xyz="0.0983 0 0.080" rpy="0 0 0"/>
      <geometry><box size="0.0177 0.0912 0.050"/></geometry>
    </collision>
    <collision>  <!-- top plate (Cube_071): X[+-0.061] Y[+-0.046] Z[0.115,0.127] -->
      <origin xyz="0 0 0.121" rpy="0 0 0"/>
      <geometry><box size="0.121 0.091 0.012"/></geometry>
    </collision>
    <collision>  <!-- mount boss (Cylinder_004): r0.041 at Z[0.127,0.140] (flange face) -->
      <origin xyz="0 0 0.134" rpy="0 0 0"/>
      <geometry><cylinder radius="0.041" length="0.013"/></geometry>
    </collision>
  </link>

  <joint name="gripper_attach_joint" type="fixed">
    <origin xyz="0 0 0.1401" rpy="3.14159265359 0 0"/>
    <parent link="Link6"/>
    <child link="gripper_base_link"/>
  </joint>

  <link name="gripper_finger_link">
    <inertial>
      <origin xyz="-0.073 0 0.023" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.00035"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/user/dobot_ws/src/blender/gripper/meshes/finger.dae"/>
      </geometry>
    </visual>
    <!-- Collision refit to finger.dae visual (Cube_096 jaw + Cube_100 tab) union AABB:
         X[-0.011,0.016] Y[+-0.035] Z[0.056,0.127]. Old box (0.064x0.129x0.160 at
         x=-0.073,z=0.023) was a phantom offset ~0.07 m in both X and Z from the
         visual finger, which is what scraped the box during the insert. -->
    <collision>
      <origin xyz="0.0025 0 0.0915" rpy="0 0 0"/>
      <geometry><box size="0.027 0.070 0.071"/></geometry>
    </collision>
  </link>

  <joint name="gripper_finger_joint" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="gripper_base_link"/>
    <child link="gripper_finger_link"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.07" upper="0.10" effort="60" velocity="0.1"/>
    <dynamics damping="5.0" friction="1.0"/>
  </joint>

  <!-- Gazebo properties for the Blender gripper links -->
  <gazebo reference="gripper_base_link">
    <material>Gazebo/DarkGrey</material>
    <gravity>false</gravity>
    <!-- Soft contact like the finger below. Without these the fixed jaw uses
         the Gazebo defaults (kp=1e12, maxVel=100): the moment the squeeze
         presses the box into the fixed pad, the near-rigid contact fires a
         huge impulse and shoots the box out of the grip. -->
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <selfCollide>true</selfCollide>
  </gazebo>
  <gazebo reference="gripper_finger_link">
    <material>Gazebo/Orange</material>
    <gravity>false</gravity>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <selfCollide>true</selfCollide>
  </gazebo>

  <!-- ===================== CR7 ros2_control ===================== -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <!-- Spawn in the folded standby pose (J1=-8, J2=-39, J3=-105 deg) so the arm
         starts tucked and never has to fold from the upright spawn pose (which
         swung it into the shelf). -->
    <joint name="joint1">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.13963</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-0.68068</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">-1.83260</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position">
        <param name="min">-1</param>
        <param name="max">1</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="gripper_finger_joint">
      <command_interface name="position">
        <param name="min">-0.07</param>
        <param name="max">0.05</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(find cr7_moveit)/config/ros2_controllers.yaml</parameters>
      <robot_param_node>robot_state_publisher</robot_param_node>
    </plugin>
  </gazebo>

</robot>

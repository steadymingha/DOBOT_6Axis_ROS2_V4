<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Publish /gazebo/model_states so the sequences can resolve WHICH box
         model sits at a pocket/slot at runtime (pocket_vision.model_at)
         instead of hardcoding box names. 2 Hz is plenty: it is read once per
         grasp. Sim-only seam; the real robot has no attacher and never asks. -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>2.0</update_rate>
    </plugin>

    <!-- AGV body + cube platform are now part of the robot URDF
         (cr7_on_mpo700.urdf.xacro: MPO-700 base + cube_link),
         so they move together with the arm. -->

    <!-- Blender shelf: 4-tier, board tops at z=0.40/0.90/1.40/1.95, footprint 2.0x0.30m.
         Pick tiers: tier-1 (board 2) 0.90, tier-2 (board 3) 1.40. The TOP board
         was raised 1.90 -> 1.95: the tier-2 insert wrist needs ~240 mm headroom
         above the flange (at 1.90 it swept into the top board, measured).
         Mirrors cr7_pnp/geometry.py SHELF_BOARD_TOPS. -->
    <!-- Raised +0.32 so tier-1 board top is 0.90+0.32 = 1.22 (= robot base 1.0m
         + 0.22, the June pick-proven relative height), tier 2 -> 1.72. Boxes
         below raised the same 0.32. Keep shelf/model.sdf leg-extension stubs
         equal to this pose z. -->
    <include>
      <name>shelf</name>
      <pose>0.8 0.5 0.32 0 0 0</pose>
      <uri>model://shelf</uri>
    </include>

    <!-- Wire-bonder beside the shelf right end (shelf spans X -0.2..1.8).
         Wirebonder is 0.952 wide in X, base centred; placed just past the end. -->
    <include>
      <name>wirebonder</name>
      <pose>2.35 0.5 0 0 0 0</pose>
      <uri>model://wirebonder</uri>
    </include>

    <!-- post_wb machine beside the wirebonder (+X side), yawed 90deg about Z.
         After yaw the footprint is 0.47 (X) x 1.02 (Y); the origin's 0.255 X-offset
         rotates into +Y, so pose_y = 0.5-0.255 to keep the body Y-centered at 0.5.
         X-center ~3.11 leaves ~0.05 gap past the wirebonder end (X=2.826); z on floor. -->
    <include>
      <name>post_wb</name>
      <pose>4.11 1.245 0.635 0 0 -1.5708</pose>
      <uri>model://post_wb</uri>
    </include>

    <!-- Shelf boxes, 4 per tier. Names box_t<tier><a-d>; a,b = inner pair,
         c,d = outer flank (one box-pitch 0.181 out); the PICK ORDER of
         sequences/shelf_pick_place.py (SHELF_BOX_XS in cr7_pnp/geometry.py;
         keep both in sync). z = board top + half box height (0.07). -->
    <include>
      <name>box_t1a</name>
      <pose>0.7095 0.5 1.29 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_t1b</name>
      <pose>0.8905 0.5 1.29 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_t1c</name>
      <pose>0.5285 0.5 1.29 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_t1d</name>
      <pose>1.0715 0.5 1.29 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <!-- Shelf tier-2 boxes: board top 1.72 + 0.07 = 1.79. Same x layout as tier 1. -->
    <include>
      <name>box_t2a</name>
      <pose>0.7095 0.5 1.79 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_t2b</name>
      <pose>0.8905 0.5 1.79 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_t2c</name>
      <pose>0.5285 0.5 1.79 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_t2d</name>
      <pose>1.0715 0.5 1.79 0 0 1.5708</pose>
      <uri>model://box</uri>
    </include>

    <!-- Wirebonder magazines: box_l2a -> slot B (G_L), box_l2b -> slot D (H_R).
         Place centre = rail centre +y by (rail_half 0.0075 + mag_half 0.0405 +
         5 mm gap) = +0.053; yaw 0 so the 236 mm side runs along the rail (world x).
         Coords from spawn_device_markers.py rail centres.
         box_l2a z: 1.281 (rail-centre convention) sat 64 mm INTO the Cube_C
         shelf; Gazebo popped it up to the settled 1.355 (= SLOT_WORLD['B']
         measured value), which put spawn-height composes 70 mm off the real
         box. Spawn AT the settled height so spawn == rest (2026-07-15). -->
    <include>
      <name>box_l2a</name>
      <pose>2.002 0.441 1.355 0 0 0</pose>
      <uri>model://box</uri>
    </include>
    <include>
      <name>box_l2b</name>
      <pose>2.698 0.441 0.896 0 0 0</pose>
      <uri>model://box</uri>
    </include>
    <!-- (the box_l2c pocket stowaway spawn was removed 2026-07-15; base-pocket
         boxes come from the shelf flow now) -->
    <!-- The floating aruco_box was removed: shelf localisation now uses the
         per-tier AprilTag plates baked into shelf/model.sdf (IDs 2/3). -->

    <!-- GUI camera initial viewpoint -->
    <gui>
      <camera name="user_camera">
        <pose>-0.82 -0.63 1.68 0.0 0.29 0.47</pose>

        <!-- <pose>0.48 -3.15 1.95 0.0 0.34 1.48</pose> -->
        <!-- <pose>-0.89 0.001 1.04 0.0 0.24 0.1</pose> -->
        <!-- <pose>3.94 -0.43 1.57 0.0 0.28 2.8</pose> -->
      </camera>
    </gui>

    <!-- Link attacher: provides /ATTACHLINK and /DETACHLINK services for grasping -->
    <plugin name="gazebo_link_attacher" filename="libgazebo_link_attacher.so"/>

  </world>
</sdf>

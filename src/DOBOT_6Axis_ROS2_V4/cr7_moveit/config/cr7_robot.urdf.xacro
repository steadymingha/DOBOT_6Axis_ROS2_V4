<?xml version="1.0"?>
<!-- Robot name MUST match the Gazebo robot_state_publisher model (cr7_on_mpo700)
     so move_group's published planning scene is not rejected by RViz with
     "Setting the scene for model 'cr7_robot' but model 'cr7_on_mpo700' is loaded".
     This URDF is still arm+gripper only (no AGV/cube); only the name is shared. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cr7_on_mpo700">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import cr7_robot urdf file -->
    <xacro:include filename="$(find dobot_rviz)/urdf/cr7_robot.urdf" />

    <!-- Gripper: single source of truth in cra_description/urdf/gripper.xacro.
         MoveIt-only description -> no Gazebo tags (gazebo_props:=false). -->
    <xacro:include filename="$(find cra_description)/urdf/gripper.xacro"/>
    <xacro:cr7_gripper gazebo_props="false"/>

    <!-- Import control_xacro -->
    <xacro:include filename="cr7_robot.ros2_control.xacro" />


    <xacro:cr7_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
